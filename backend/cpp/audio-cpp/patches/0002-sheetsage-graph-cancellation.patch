+runtime::OfflineCancellationSupport SheetSage2Session::cancellation_support() const noexcept {
+    return execution_context().supports_cancellation()
+        ? runtime::OfflineCancellationSupport::GraphOnly
+        : runtime::OfflineCancellationSupport::Unsupported;
+}
+
+runtime::TaskResult SheetSage2Session::run_cancellable(
+    const runtime::TaskRequest & request, core::RunStopHandle stop) {
+    // Binding rejects null, nested and unsupported resolved backends before work.
+    auto binding = execution_context().begin_cancellable_run(std::move(stop));
+    try {
+        if (execution_context().stop_requested()) throw runtime::RunCancelled();
+        auto result = run_impl(request);
+        if (execution_context().stop_requested()) throw runtime::RunCancelled();
+        return result;
+    } catch (...) {
+        // Computation is synchronous and settled before releasing any graph/KV.
+        encoder_.release_runtime_graphs();
+        decoder_.release_runtime_graphs();
+        throw;
+    }
+}
+
 runtime::TaskResult SheetSage2Session::run(const runtime::TaskRequest & request) {
+    try {
+        return run_impl(request);
+    } catch (...) {
+        encoder_.release_runtime_graphs();
+        decoder_.release_runtime_graphs();
+        throw;
+    }
+}
+
+runtime::TaskResult SheetSage2Session::run_impl(const runtime::TaskRequest & request) {
     require_prepared("SheetSage2 run");
     runtime::validate_spec_backed_request_options(request.options, *contract_, "SheetSage2");
     if (!request.audio_input.has_value()) {
