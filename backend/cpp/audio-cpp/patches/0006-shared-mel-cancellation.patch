+struct NormalizedMelStop {
+    engine::audio::FFTStop upstream;
+    std::atomic<bool> cancelled{false};
+    static bool requested(void * p) noexcept {
+        auto & self = *static_cast<NormalizedMelStop *>(p);
+        if (self.upstream.requested && self.upstream.requested(self.upstream.data))
+            self.cancelled = true;
+        return self.cancelled.load(std::memory_order_acquire);
+    }
+    engine::audio::FFTStop bridge() noexcept { return {requested, this}; }
+    void check() { if (requested(this)) throw runtime::RunCancelled(); }
+};
+
+std::vector<float> prepare_normalized_mel(
+    const std::vector<float> & waveform,
+    const SheetSage2Assets & assets,
+    size_t threads,
+    int64_t & mel_frames_out, engine::audio::FFTStop callback) {
+    if (static_cast<int64_t>(waveform.size()) <= assets.config.n_fft) {
+        throw std::runtime_error("SheetSage2 window audio is too short for the audio frontend");
+    }
+    if (assets.config.mel_bins <= 0 ||
+        assets.mel_mean.size() != static_cast<size_t>(assets.config.mel_bins) ||
+        assets.mel_std.size() != static_cast<size_t>(assets.config.mel_bins))
+        throw std::runtime_error("SheetSage2 mel normalization shape mismatch");
+    const auto & bank = assets.mel_filterbank;
+    const int64_t bins = assets.config.n_fft / 2 + 1;
+    if (bank.dense.shape.size() != 2 || bank.dense.shape[1] != bins)
+        throw std::runtime_error("SparseMelFilterbank filterbank shape mismatch");
+    if (bank.dense.shape[0] != assets.config.mel_bins || bins <= 0 ||
+        assets.config.mel_bins > std::numeric_limits<int64_t>::max() / bins ||
+        bank.dense.values.size() != static_cast<size_t>(assets.config.mel_bins * bins) ||
+        bank.starts.size() != static_cast<size_t>(assets.config.mel_bins) ||
+        bank.ends.size() != static_cast<size_t>(assets.config.mel_bins))
+        throw std::runtime_error("SparseMelFilterbank metadata shape mismatch");
+    for (int64_t m = 0; m < assets.config.mel_bins; ++m) {
+        if (bank.starts[m] < 0 || bank.ends[m] < bank.starts[m] || bank.ends[m] > bins)
+            throw std::runtime_error("SparseMelFilterbank metadata range mismatch");
+    }
+    NormalizedMelStop stop{callback};
+    const int64_t target_samples = static_cast<int64_t>(waveform.size());
+    const engine::audio::STFTConfig stft_config{
+        assets.config.n_fft,
+        assets.config.hop_length,
+        assets.config.win_length,
+        true,
+        engine::audio::STFTPadMode::Reflect,
+        engine::audio::STFTFamily::Default,
+    };
+    auto magnitude = engine::audio::STFT().compute_magnitude(
+        waveform,
+        assets.stft_window,
+        1,
+        target_samples,
+        stft_config,
+        threads, stop.bridge());
+#ifdef ENGINE_MEL_TESTING
+    mel_testing::child_returned(0, magnitude.status);
+#endif
+    if (magnitude.status == engine::audio::FFTStatus::Cancelled)
+        throw runtime::RunCancelled();
+    const int64_t freq_bins = assets.config.n_fft / 2 + 1;
+    const int64_t stft_frames = magnitude.output.value().shape.at(2);
+    const int64_t mel_frames = stft_frames - 1;
+    auto mel = engine::audio::MelFilterbank().compute_custom_sparse_from_magnitude(
+        magnitude.output.value().values,
+        1,
+        freq_bins,
+        stft_frames,
+        mel_frames,
+        assets.mel_filterbank, stop.bridge());
+#ifdef ENGINE_MEL_TESTING
+    mel_testing::child_returned(1, mel.status);
+#endif
+    if (mel.status == engine::audio::FFTStatus::Cancelled)
+        throw runtime::RunCancelled();
+    if (mel.output.value().shape.size() != 3 || mel.output.value().shape[1] != assets.config.mel_bins || mel.output.value().shape[2] != mel_frames) {
+        throw std::runtime_error("SheetSage2 mel frontend produced invalid shape");
+    }
+    stop.check();
+    if (mel_frames > std::numeric_limits<int64_t>::max() / assets.config.mel_bins)
+        throw std::runtime_error("SheetSage2 normalized mel size overflow");
+    std::vector<float> normalized(static_cast<size_t>(mel_frames * assets.config.mel_bins), 0.0F);
+    stop.check();
+    size_t writes = 0;
+    for (int64_t t = 0; t < mel_frames; ++t) {
+        for (int64_t m = 0; m < assets.config.mel_bins; ++m) {
+            if (writes % 64 == 0) stop.check(); // normalized write tile
+            const float power = std::max(mel.output.value().values[static_cast<size_t>(m * mel.output.value().shape[2] + t)], 1.0e-10F);
+            const float db = 10.0F * std::log10(power);
+            const float stdv = std::max(assets.mel_std[static_cast<size_t>(m)], 1.0e-5F);
+            normalized[static_cast<size_t>(t * assets.config.mel_bins + m)] =
+                (db - assets.mel_mean[static_cast<size_t>(m)]) / stdv;
+            ++writes;
+#ifdef ENGINE_MEL_TESTING
+            mel_testing::normalized(writes - 1, normalized[writes - 1]);
+#endif
+        }
+    }
+    stop.check(); // final short tile and publication
+    mel_frames_out = mel_frames;
+    return normalized;
+}
