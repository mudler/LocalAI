# Stops a Qwen3-TTS backbone from sampling outside the codec range, which
# otherwise aborts the whole backend process partway through an utterance.
#
# The gen-audio pipeline maps a sampled token to a codebook row with an
# unchecked subtraction, in tools/mtmd/mtmd-helper-gen.cpp:
#
#     inp.code0 = sampled - codec_0;
#
# For ggml-org/Qwen3-TTS-12Hz-1.7B-Base-GGUF the vocab is 155008 tokens,
# <|codec_0|> is 151936 and the valid codec codes run to 153983. The model's
# own tokenizer.ggml.suppress_tokens holds 1023 ids covering 153984..155007,
# every special ABOVE the codec range except <|codec_eos_token|> (154086),
# which is deliberately left reachable as the stop token. Nothing masks the
# text range 0..151935, so the backbone can sample a text token at any step,
# `sampled - codec_0` goes negative, and ggml_compute_forward_get_rows fires
# GGML_ASSERT(i01 >= 0 && i01 < ne01) at ggml/src/ggml-cpu/ops.cpp:4886.
# That is an abort(), not an error return, so it kills the process.
#
# This is reproducible with upstream's own tool and no LocalAI code loaded:
#
#     llama-tts -m Qwen3-TTS-12Hz-1.7B-Base-Q4_K_M.gguf \
#               --mmproj mmproj-Qwen3-TTS-12Hz-1.7B-Base-Q8_0.gguf \
#               -p "Hello world, this is a test of the llama C P P text to speech path." \
#               --tts-lang en --tts-speaker-file ref-24k.wav -o out.wav
#
# aborting at frame 55 on Q4_K_M and frame 71 on Q8_0, so it is not an
# artifact of quantization and not of the LocalAI gRPC adapter.
#
# The fix completes the mask upstream started: bias every token below
# <|codec_0|> to -INFINITY for TTS tasks, leaving 151936..153983 plus the
# codec EOS as the only reachable ids. The backbone then runs to its real
# stop token instead of derailing. The bias is appended to
# task.params.sampling.logit_bias, which common/sampling.cpp already merges
# with the model's suppress tokens into one llama_sampler_init_logit_bias,
# so no sampler is added to the chain. <|codec_0|> is resolved from the vocab
# rather than hardcoded, and a model without it is left alone (has_cap_tts()
# should already have kept a non-TTS model off this path).
#
# It lands in launch_slot_with_task rather than in the HTTP route handler so
# that both llama.cpp's own POST /tts and LocalAI's gRPC TTS/TTSStream RPCs
# are covered by one code path.
#
# Rebased against LLAMA_VERSION f9e832c10 with 0001-add-server-task-type-score.patch
# and 0002-add-server-task-type-tts.patch already applied: this extends the
# SERVER_TASK_TYPE_TTS block that 0002 adds to launch_slot_with_task, so it
# must stay third in ls order.
#
# REMOVE THIS PATCH once the sampling range is constrained upstream and
# LLAMA_VERSION is bumped past that fix. Reported against the #26603 draft.
diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
index 88fb0b7..88bb67d 100644
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -40,6 +40,19 @@ using json = nlohmann::ordered_json;
 
 constexpr int HTTP_POLLING_SECONDS = 1;
 
+// Same linear scan mtmd-helper-gen.cpp uses to resolve its codec markers. That
+// one is file-static and cannot be shared, and this runs once per TTS task
+// rather than per token, so the scan cost does not matter.
+static llama_token server_find_special_token(const llama_vocab * vocab, const std::string & piece) {
+    const int32_t n = llama_vocab_n_tokens(vocab);
+    for (llama_token t = 0; t < n; t++) {
+        if (piece == llama_vocab_get_text(vocab, t)) {
+            return t;
+        }
+    }
+    return LLAMA_TOKEN_NULL;
+}
+
 static uint32_t server_n_outputs_max(const common_params & params) {
     const uint32_t n_batch  = params.n_batch;
 
@@ -1896,6 +1909,31 @@ private:
                 send_error(task, "failed to process TTS prompt", ERROR_TYPE_SERVER);
                 return false;
             }
+
+            // The gen-audio pipeline turns a sampled token into a codebook row with
+            // an unchecked subtraction (mtmd-helper-gen.cpp: `inp.code0 = sampled - codec_0`),
+            // so anything sampled below <|codec_0|> is a negative row index and trips
+            // GGML_ASSERT(i01 >= 0 && i01 < ne01) in ggml_compute_forward_get_rows,
+            // aborting the process mid-utterance.
+            //
+            // The model's own tokenizer.ggml.suppress_tokens masks the ids ABOVE the
+            // codec range and nothing below it, leaving the whole text range reachable.
+            // Complete that mask here so the backbone can only emit codec codes or the
+            // codec EOS it stops on. Biases merge into the single logit_bias sampler
+            // common_sampler_init already builds, so this adds no sampler to the chain.
+            const llama_token codec_0 = server_find_special_token(vocab, "<|codec_0|>");
+            if (codec_0 == LLAMA_TOKEN_NULL) {
+                // has_cap_tts() should have kept a non-Qwen3-TTS model off this path.
+                // Leave sampling alone rather than guess at a range.
+                SLT_WRN(slot, "%s", "<|codec_0|> not found in vocab, cannot mask non-codec tokens\n");
+            } else {
+                auto & logit_bias = task.params.sampling.logit_bias;
+                logit_bias.reserve(logit_bias.size() + (size_t) codec_0);
+                for (llama_token t = 0; t < codec_0; t++) {
+                    logit_bias.push_back({ t, -INFINITY });
+                }
+                SLT_DBG(slot, "masked %d non-codec tokens below <|codec_0|>\n", codec_0);
+            }
         }
 
         // initialize samplers
