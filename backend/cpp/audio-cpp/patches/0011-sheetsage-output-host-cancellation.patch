+void validate_sheetsage2_output(const std::vector<SheetSage2Event> & events,
+    double duration,const SheetSage2OutputDomain & domain) {
+    if(domain.context_per_window<=0 || domain.window_count<=0 ||
+       static_cast<uint64_t>(domain.context_per_window)>(std::numeric_limits<size_t>::max()-1)/static_cast<uint64_t>(domain.window_count) ||
+       !std::isfinite(duration) || duration<0 || duration>std::numeric_limits<float>::max())
+        throw std::runtime_error("SheetSage2 output request domain is invalid");
+    const size_t budget=static_cast<size_t>(domain.context_per_window)*static_cast<size_t>(domain.window_count);
+    if(events.size()>budget)throw std::runtime_error("SheetSage2 events exceed request domain");
+    if(budget>(std::numeric_limits<size_t>::max()-static_cast<size_t>(domain.window_count))/8)throw std::runtime_error("SheetSage2 output expansion exceeds supported range");
+    const size_t field_budget=8*budget+static_cast<size_t>(domain.window_count);
