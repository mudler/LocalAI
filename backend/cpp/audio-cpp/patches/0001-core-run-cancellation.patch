     : config_(config),
+      bridge_(std::make_shared<RunCallbackBridge>()),
       backend_(init_backend(config)) {
+    bridge_->supported = set_backend_abort_callback(backend_, abort_run, bridge_.get());
     if (backend_ != nullptr && config_.threads > 0) {
         set_backend_threads(backend_, config_.threads);
     }
 }
 
