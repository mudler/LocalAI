{
  "api": {
    "max": 1,
    "min": 1
  },
  "arch": "amd64",
  "capabilities": {
    "actions": true,
    "toolDefinitions": [
      {
        "name": "bash",
        "description": "Run a shell script with bash in /workspace. Output is cut at 64 KiB. A call stops after timeoutSeconds (default 120, at most 1680).",
        "kind": "action",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "command": {
              "description": "The script to run.",
              "type": "string"
            },
            "timeoutSeconds": {
              "maximum": 1680,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        }
      },
      {
        "name": "read",
        "description": "Read lines of a text file. offset is the first line (default 1), limit the number of lines (default 2000).",
        "kind": "action",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "limit": {
              "minimum": 1,
              "type": "integer"
            },
            "offset": {
              "minimum": 1,
              "type": "integer"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path"
          ],
          "type": "object"
        }
      },
      {
        "name": "write",
        "description": "Write a file. It replaces the file when it exists and creates the folders above it.",
        "kind": "action",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "content": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "path",
            "content"
          ],
          "type": "object"
        }
      },
      {
        "name": "edit",
        "description": "Replace text in a file. oldString must match exactly once, unless replaceAll is true.",
        "kind": "action",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "newString": {
              "type": "string"
            },
            "oldString": {
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "replaceAll": {
              "type": "boolean"
            }
          },
          "required": [
            "path",
            "oldString",
            "newString"
          ],
          "type": "object"
        }
      },
      {
        "name": "glob",
        "description": "List files whose path matches a pattern. In the pattern, * matches any characters including /. At most 500 results.",
        "kind": "action",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "path": {
              "description": "The folder to search. Default: the working directory.",
              "type": "string"
            },
            "pattern": {
              "description": "For example *.md or reports/*.xlsx",
              "type": "string"
            }
          },
          "required": [
            "pattern"
          ],
          "type": "object"
        }
      },
      {
        "name": "grep",
        "description": "Search file contents with an extended regular expression. At most 200 lines.",
        "kind": "action",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "ignoreCase": {
              "type": "boolean"
            },
            "path": {
              "description": "A file or folder. Default: the working directory.",
              "type": "string"
            },
            "pattern": {
              "type": "string"
            }
          },
          "required": [
            "pattern"
          ],
          "type": "object"
        }
      },
      {
        "name": "status",
        "description": "Say whether this host can run commands in a sandbox now, and which backend runs them.",
        "kind": "read",
        "inputSchema": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      }
    ],
    "tools": [
      "bash",
      "read",
      "write",
      "edit",
      "glob",
      "grep",
      "status",
      "set-backend",
      "confirm-host"
    ],
    "ui": {
      "css": [
        "ui/sandbox.css"
      ],
      "description": "Let your chats run commands and code in an isolated sandbox, with your files mounted.",
      "entry": "ui/sandbox.js",
      "icon": "ui/icon.png",
      "mainPage": "sandbox",
      "pages": [
        "sandbox"
      ],
      "sdk": {
        "max": 2,
        "min": 2
      },
      "title": "Sandbox",
      "slots": [
        {
          "id": "settings",
          "slot": "settings.sections",
          "component": "SandboxSettings"
        }
      ]
    }
  },
  "dataFormat": {
    "max": 1,
    "min": 1
  },
  "executable": "sandbox",
  "host": {
    "max": 1,
    "min": 1
  },
  "id": "sandbox",
  "os": "linux",
  "protocol": {
    "max": 1,
    "min": 1
  },
  "schemaVersion": 1,
  "version": "0.1.0"
}
