{
  "schemaVersion": 1,
  "id": "memory",
  "version": "0.1.0",
  "executable": "memory",
  "os": "linux",
  "arch": "amd64",
  "host": { "min": 1, "max": 1 },
  "api": {"min": 2, "max": 2},
  "protocol": { "min": 1, "max": 1 },
  "dataFormat": { "min": 1, "max": 1 },
  "capabilities": {
    "skillDefinitions": [
      { "name": "memory" },
      { "name": "memory-check-own-files" }
    ],
    "contextFiles": [
      { "scope": "user", "path": "Memory/index.md" },
      { "scope": "agent", "path": "Memory/agents/{agent}/index.md" },
      { "scope": "channel", "path": "Memory/channels/{channel}/index.md" }
    ],
    "userSettings": [
      { "key": "save-mode", "values": ["ask", "auto", "never"], "default": "ask", "role": "memory.save-mode" }
    ],
    "ui": {
      "entry": "ui/memory.js",
      "css": ["ui/memory.css"],
      "sdk": { "min": 2, "max": 2 },
      "pages": ["memory"],
      "mainPage": "memory",
      "icon": "ui/icon.png",
      "title": "Short memory",
      "description": "Your chats keep short notes about you and read them before they answer. By default a new note is saved only after you confirm it; you can choose to have it saved at once with an Undo, or never."
    }
  }
}
