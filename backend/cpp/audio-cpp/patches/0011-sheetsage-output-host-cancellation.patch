+std::vector<SheetSage2Event> stitched_window_events(
+    const std::vector<SheetSage2Event> & decoded_events,
+    const std::function<double(int64_t)> & time_lookup,
+    const SheetSage2Window & window,
+    double song_duration,
+    int64_t global_subbeat_base) {
+    constexpr double eps = 1.0e-4;
+    validate_events(decoded_events,song_duration);
+    if(!std::isfinite(window.start)||!std::isfinite(window.accept_start)||!std::isfinite(window.accept_end)||window.index<0||window.index>std::numeric_limits<int>::max()||window.start<0||global_subbeat_base<0)throw std::runtime_error("SheetSage2 stitch window is invalid");
