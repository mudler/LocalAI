+++ b/src/cli/serve/inference_backend.cpp
@@ -3719,4 +3719,17 @@ std::size_t InferenceBackend::count_tokens(std::string_view text) const {
 #endif
 }
 
+std::vector<std::uint32_t> InferenceBackend::tokenize(std::string_view text) const {
+#if defined(ENGINE_ENABLE_HIP)
+  const auto state = impl_->Snapshot();
+  if (state == nullptr) {
+    return {};
+  }
+  return state->scheduler->runner().Tokenize(text);
+#else
+  (void)text;
+  return {};
+#endif
+}
+
 }  // namespace gufo::server
