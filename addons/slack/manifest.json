{
  "schemaVersion": 1,
  "id": "slack",
  "version": "0.1.0",
  "executable": "slack",
  "os": "linux",
  "arch": "amd64",
  "host": { "min": 1, "max": 1 },
  "api": {"min": 2, "max": 2},
  "protocol": { "min": 1, "max": 1 },
  "dataFormat": { "min": 1, "max": 1 },
  "capabilities": {
    "hostOperations": {
      "optional": ["connector.file.get", "connector.file.put"]
    },
    "connector": {
      "kinds": [
        {
          "id": "slack",
          "title": "Slack",
          "description": "Talk to one of your saved agents from Slack, in direct messages and in channel threads.",
          "senderHint": "A user ID (U...), a channel ID (C...) or an @name",
          "delivery": "pull",
          "files": {
            "receive": { "maxBytes": 1073741824 },
            "send": { "maxBytes": 1073741824 }
          },
          "page": "apps",
          "history": { "thread": true, "maxMessages": 30 },
          "options": [
            {
              "id": "followThreads",
              "title": "Threads the bot follows",
              "description": "Whether the bot answers replies in a thread without a new mention.",
              "default": "own",
              "values": [
                { "id": "own", "title": "Only threads it started" },
                { "id": "any", "title": "Any thread it was mentioned in" },
                { "id": "never", "title": "None: always ask with a mention" }
              ]
            }
          ]
        }
      ]
    },
    "ui": {
      "entry": "ui/slack.js",
      "css": ["ui/slack.css"],
      "sdk": { "min": 2, "max": 2 },
      "pages": ["apps"],
      "mainPage": "apps",
      "icon": "ui/icon.png",
      "title": "Slack",
      "description": "Bind a Slack app to one of your saved agents, so people can talk to it from Slack."
    }
  }
}
