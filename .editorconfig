
root = true

[*]
indent_style = space
indent_size = 2
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.proto]
indent_size = 2

[*.py]
indent_size = 4

[*.js]
indent_size = 2

[*.yaml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Patches must keep the line endings and trailing spaces of the files they change.
[backend/cpp/audio-cpp/patches/*.patch]
end_of_line = unset
trim_trailing_whitespace = false
insert_final_newline = unset
