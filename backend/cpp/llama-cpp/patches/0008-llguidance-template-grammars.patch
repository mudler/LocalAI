+    const llama_vocab * vocab;
+
+    LlgTokenizer * tokenizer;
+    LlgMatcher *   matcher; // nullptr once on the fallback
+
+    std::vector<llama_token> llg_prefill;  // generation prompt as plain-text tokens
+    std::vector<llama_token> gbnf_prefill; // generation prompt as common_sampler_init feeds GBNF
+
+    bool lazy;
+    bool awaiting;
+    std::string                                                       buffer;
+    std::vector<std::pair<llama_token, std::pair<size_t, size_t>>>   buffer_pos;
+    std::vector<std::string>                                          patterns;
+    std::vector<std::regex>                                           regexes;
+    std::vector<llama_token>                                          trigger_tokens;
+
+    std::string              gbnf;
+    std::vector<llama_token> history;       // tokens accepted since the start, for the GBNF replay
+    llama_sampler *          shadow;        // GBNF in step with llguidance, built on the first rejection
+    bool                     shadow_failed; // GBNF cannot be built or replayed: no shadow
+    llama_sampler *          fallback;      // GBNF, after an llguidance error or disagreement
+    bool                     failed;        // the fallback failed too: no constraint
+};
+
+static const char * llama_sampler_llg_gbnf_name(const llama_sampler * smpl) {
+    const auto * ctx = (const llama_sampler_llg_gbnf *) smpl->ctx;
+    return ctx->fallback ? "llguidance-gbnf:on-gbnf" : (ctx->failed ? "llguidance-gbnf:none" : "llguidance-gbnf");
+}
+
+// Same as llama_grammar_trigger_pattern::find: the start of the first non-empty capture group, else
+// of the match. A pattern anchored with ^...$ must match the whole buffer.
+static size_t llg_gbnf_trigger_find(const std::string & pattern, const std::regex & re, const std::string & input) {
+    std::smatch m;
+    const bool full  = !pattern.empty() && pattern.front() == '^' && pattern.back() == '$';
+    const bool found = full ? std::regex_match(input, m, re) : std::regex_search(input, m, re);
+    if (!found) {
+        return std::string::npos;
+    }
+    for (size_t i = 1; i < m.size(); i++) {
+        if (m.length(i) > 0) {
+            return m.position(i);
+        }
+    }
+    return m.position(0);
+}
+
+// GBNF prefilled as common_sampler_init would, with every accepted token replayed; nullptr on failure
+static llama_sampler * llg_gbnf_build_gbnf(const llama_sampler_llg_gbnf * ctx, std::string & error) {
+    llama_sampler * g = nullptr;
+    try {
+        if (ctx->lazy) {
+            std::vector<const char *> pats;
+            for (const auto & p : ctx->patterns) {
+                pats.push_back(p.c_str());
+            }
+            g = llama_sampler_init_grammar_lazy_patterns(ctx->vocab, ctx->gbnf.c_str(), "root", pats.data(), pats.size(),
+                                                         ctx->trigger_tokens.data(), ctx->trigger_tokens.size());
+        } else {
+            g = llama_sampler_init_grammar(ctx->vocab, ctx->gbnf.c_str(), "root");
+        }
+        if (!g) {
+            throw std::runtime_error("GBNF rejected the grammar");
+        }
+        for (const auto t : ctx->gbnf_prefill) {
+            llama_sampler_accept(g, t);
+        }
+        for (const auto t : ctx->history) {
+            if (!llama_vocab_is_eog(ctx->vocab, t)) {
+                llama_sampler_accept(g, t);
+            }
+        }
+    } catch (const std::exception & e) {
+        if (g) {
+            llama_sampler_free(g);
+        }
+        error = e.what();
+        return nullptr;
+    }
+    return g;
+}
+
+static void llg_gbnf_to_fallback(llama_sampler_llg_gbnf * ctx, const char * reason) {
+    LOG_WRN("llguidance: %s; continuing this request on GBNF\n", reason ? reason : "unknown error");
+    if (ctx->matcher) {
+        llg_free_matcher(ctx->matcher);
+        ctx->matcher = nullptr;
+    }
+    if (ctx->shadow) {
+        ctx->fallback = ctx->shadow;
+        ctx->shadow   = nullptr;
+        return;
+    }
+    std::string error;
+    ctx->fallback = ctx->shadow_failed ? nullptr : llg_gbnf_build_gbnf(ctx, error);
+    if (!ctx->fallback) {
+        LOG_ERR("llguidance: the GBNF fallback failed too (%s); the rest of this output is not constrained\n",
+                ctx->shadow_failed ? "no GBNF for this grammar" : error.c_str());
+        ctx->failed = true;
+    }
+}
+
+// llguidance rejected a token. llguidance lexes greedily and never backtracks, so in a few grammars it
+// rejects a token GBNF accepts. Ask GBNF (built once, then kept in step); if GBNF accepts the token,
+// the request goes on on GBNF. Returns true when it switched.
+static bool llg_gbnf_check_rejection(llama_sampler_llg_gbnf * ctx, llama_token token) {
+    if (ctx->shadow_failed) {
+        return false;
+    }
+    if (!ctx->shadow) {
+        std::string error;
+        ctx->shadow = llg_gbnf_build_gbnf(ctx, error);
+        if (!ctx->shadow) {
+            LOG_DBG("llguidance: no GBNF shadow: %s\n", error.c_str());
+            ctx->shadow_failed = true;
+            return false;
+        }
+    }
+    llama_token_data       d   = { token, 1.0f, 0.0f };
+    llama_token_data_array arr = { &d, 1, -1, false };
+    llama_sampler_apply(ctx->shadow, &arr);
+    if (d.logit == -INFINITY) {
+        return false;
+    }
+    const std::string piece = common_token_to_piece(ctx->vocab, token, true);
+    const std::string msg   = "llguidance rejects token '" + piece + "' that GBNF accepts";
+    llg_gbnf_to_fallback(ctx, msg.c_str());
+    return true;
+}
+
+static bool llg_gbnf_consume(llama_sampler_llg_gbnf * ctx, llama_token token) {
+    if (llg_matcher_consume_token(ctx->matcher, (uint32_t) token) != 0) {
+        llg_gbnf_to_fallback(ctx, llg_matcher_get_error(ctx->matcher));
+        return false;
+    }
+    return true;
+}
+
+static void llama_sampler_llg_gbnf_accept(llama_sampler * smpl, llama_token token) {
+    auto * ctx = (llama_sampler_llg_gbnf *) smpl->ctx;
+    ctx->history.push_back(token);
+    if (ctx->shadow && !llama_vocab_is_eog(ctx->vocab, token)) {
+        try {
+            llama_sampler_accept(ctx->shadow, token);
+        } catch (const std::exception & e) {
+            LOG_DBG("llguidance: GBNF shadow dropped: %s\n", e.what());
+            llama_sampler_free(ctx->shadow);
+            ctx->shadow        = nullptr;
+            ctx->shadow_failed = true;
+        }
+    }
+    if (ctx->fallback) {
+        llama_sampler_accept(ctx->fallback, token);
+        return;
+    }
+    if (!ctx->matcher) {
+        return;
+    }
+    if (!ctx->awaiting) {
+        // an end-of-generation token after a complete output ends it, as on GBNF
+        if (llama_vocab_is_eog(ctx->vocab, token) && llg_matcher_is_accepting(ctx->matcher)) {
+            return;
+        }
+        llg_gbnf_consume(ctx, token);
+        return;
+    }
+    if (std::find(ctx->trigger_tokens.begin(), ctx->trigger_tokens.end(), token) != ctx->trigger_tokens.end()) {
+        ctx->awaiting = false;
+        ctx->buffer.clear();
+        ctx->buffer_pos.clear();
+        LOG_DBG("llguidance: triggered on token %d\n", token);
+        llg_gbnf_consume(ctx, token);
+        return;
+    }
+    const std::string piece = common_token_to_piece(ctx->vocab, token, true);
+    ctx->buffer_pos.push_back({ token, { ctx->buffer.size(), ctx->buffer.size() + piece.size() } });
+    ctx->buffer += piece;
+    for (size_t i = 0; i < ctx->regexes.size(); i++) {
+        const size_t start = llg_gbnf_trigger_find(ctx->patterns[i], ctx->regexes[i], ctx->buffer);
+        if (start == std::string::npos) {
+            continue;
+        }
+        ctx->awaiting = false;
+        // replay the tokens from the trigger start on; a token that starts before it is tokenized
+        // again from the trigger start, as llama-grammar.cpp feeds its partial piece
+        std::vector<llama_token> replay;
+        for (const auto & [tok, pos] : ctx->buffer_pos) {
+            if (pos.second <= start) {
+                continue;
+            }
+            if (pos.first >= start) {
+                replay.push_back(tok);
+                continue;
+            }
+            const auto part = common_tokenize(ctx->vocab, ctx->buffer.substr(start, pos.second - start), false, true);
+            replay.insert(replay.end(), part.begin(), part.end());
+        }
+        LOG_DBG("llguidance: triggered on pattern '%s', replaying %zu tokens of '%s'\n", ctx->patterns[i].c_str(),
+                replay.size(), ctx->buffer.substr(start).c_str());
+        ctx->buffer.clear();
+        ctx->buffer_pos.clear();
+        for (const auto t : replay) {
+            if (!llg_gbnf_consume(ctx, t)) {
+                return;
+            }
+        }
+        return;
+    }
+}
+
+static void llama_sampler_llg_gbnf_apply(llama_sampler * smpl, llama_token_data_array * cur_p) {
+    auto * ctx = (llama_sampler_llg_gbnf *) smpl->ctx;
+    if (ctx->fallback) {
+        llama_sampler_apply(ctx->fallback, cur_p);
+        return;
+    }
+    if (!ctx->matcher || ctx->awaiting) {
+        return;
+    }
+    const uint32_t * mask = llg_matcher_get_mask(ctx->matcher);
+    if (mask == nullptr && cur_p->size <= LLG_FAST_PATH_MAX) {
+        std::vector<float> logits(cur_p->size);
+        for (size_t i = 0; i < cur_p->size; ++i) {
+            logits[i] = cur_p->data[i].logit;
+        }
+        if (!llama_sampler_llg_apply_few(ctx->matcher, ctx->vocab, cur_p)) {
+            for (size_t i = 0; i < cur_p->size; ++i) {
+                cur_p->data[i].logit = logits[i];
+            }
+            llg_gbnf_to_fallback(ctx, llg_matcher_get_error(ctx->matcher));
+            llama_sampler_llg_gbnf_apply(smpl, cur_p);
+            return;
+        }
+        for (size_t i = 0; i < cur_p->size; ++i) {
+            if (cur_p->data[i].logit == -INFINITY && logits[i] != -INFINITY &&
+                llg_gbnf_check_rejection(ctx, cur_p->data[i].id)) {
+                for (size_t k = 0; k < cur_p->size; ++k) {
+                    cur_p->data[k].logit = logits[k];
+                }
+                llama_sampler_llg_gbnf_apply(smpl, cur_p);
+                return;
+            }
+        }
+        return;
+    }
+    if (mask == nullptr) {
+        if (llg_matcher_compute_mask(ctx->matcher) != 0) {
+            llg_gbnf_to_fallback(ctx, llg_matcher_get_error(ctx->matcher));
+            llama_sampler_llg_gbnf_apply(smpl, cur_p);
+            return;
+        }
+        mask = llg_matcher_get_mask(ctx->matcher);
+    }
+    // llguidance allows only its own end token; any end-of-generation token ends a complete output
+    const bool accepting = llg_matcher_is_accepting(ctx->matcher);
+    for (size_t i = 0; i < cur_p->size; ++i) {
+        const llama_token token = cur_p->data[i].id;
+        // the mask allows an end token only when accepting (llguidance's own); add the other ones then
+        const bool ok = (mask[token / 32] & (1u << (token % 32))) != 0 || (accepting && llama_vocab_is_eog(ctx->vocab, token));
+        if (!ok) {
+            cur_p->data[i].logit = -INFINITY;
+        }
+    }
+}
+
+static void llg_gbnf_start(llama_sampler_llg_gbnf * ctx) {
+    ctx->awaiting = ctx->lazy;
+    ctx->buffer.clear();
+    ctx->buffer_pos.clear();
+    ctx->history.clear();
+    for (const auto t : ctx->llg_prefill) {
+        if (!llg_gbnf_consume(ctx, t)) {
+            break;
+        }
+    }
+}
+
+static void llama_sampler_llg_gbnf_reset(llama_sampler * smpl) {
+    auto * ctx = (llama_sampler_llg_gbnf *) smpl->ctx;
+    if (ctx->shadow) {
+        llama_sampler_free(ctx->shadow);
+        ctx->shadow = nullptr;
+    }
+    if (ctx->fallback) {
+        // stays on GBNF for the life of this sampler
+        llama_sampler_reset(ctx->fallback);
+        ctx->history.clear();
+        for (const auto t : ctx->gbnf_prefill) {
+            llama_sampler_accept(ctx->fallback, t);
+        }
+        return;
+    }
+    if (ctx->matcher && llg_matcher_reset(ctx->matcher) == 0) {
+        llg_gbnf_start(ctx);
+    }
+}
+
+static llama_sampler * llama_sampler_llg_gbnf_clone(const llama_sampler * smpl);
+
+static void llama_sampler_llg_gbnf_free(llama_sampler * smpl) {
+    auto * ctx = (llama_sampler_llg_gbnf *) smpl->ctx;
+    if (ctx->matcher) {
+        llg_free_matcher(ctx->matcher);
+    }
+    if (ctx->tokenizer) {
+        llg_free_tokenizer(ctx->tokenizer);
+    }
+    if (ctx->fallback) {
+        llama_sampler_free(ctx->fallback);
+    }
+    if (ctx->shadow) {
+        llama_sampler_free(ctx->shadow);
+    }
+    delete ctx;
+}
+
+static llama_sampler_i llama_sampler_llg_gbnf_i = {
+    /* .name              = */ llama_sampler_llg_gbnf_name,
+    /* .accept            = */ llama_sampler_llg_gbnf_accept,
+    /* .apply             = */ llama_sampler_llg_gbnf_apply,
+    /* .reset             = */ llama_sampler_llg_gbnf_reset,
+    /* .clone             = */ llama_sampler_llg_gbnf_clone,
+    /* .free              = */ llama_sampler_llg_gbnf_free,
+    /* .backend_init      = */ NULL,
+    /* .backend_accept    = */ NULL,
+    /* .backend_apply     = */ NULL,
+    /* .backend_set_input = */ NULL,
+    /* .backend_reset     = */ NULL,
+    /* .copy_state        = */ NULL,
+};
+
+static llama_sampler * llama_sampler_llg_gbnf_clone(const llama_sampler * smpl) {
+    const auto * ctx  = (const llama_sampler_llg_gbnf *) smpl->ctx;
+    auto *       copy = new llama_sampler_llg_gbnf(*ctx);
+    copy->tokenizer   = ctx->tokenizer ? llg_clone_tokenizer(ctx->tokenizer) : nullptr;
+    copy->matcher     = ctx->matcher ? llg_clone_matcher(ctx->matcher) : nullptr;
+    copy->fallback    = ctx->fallback ? llama_sampler_clone(ctx->fallback) : nullptr;
+    copy->shadow      = ctx->shadow ? llama_sampler_clone(ctx->shadow) : nullptr;
+    return llama_sampler_init(&llama_sampler_llg_gbnf_i, copy);
+}
+
+llama_sampler * llama_sampler_init_llg_from_gbnf(const llama_vocab * vocab, const std::string & gbnf, bool lazy,
+                                                 const std::vector<std::string> & trigger_patterns,
+                                                 const std::vector<llama_token> & trigger_tokens,
+                                                 const std::string & generation_prompt, std::string * error) {
+    auto set_error = [&](const std::string & msg) {
+        if (error) {
+            *error = msg;
+        }
+        return nullptr;
+    };
+
+    std::string lark;
+    try {
+        lark = common_gbnf_to_lark(gbnf, vocab);
+    } catch (const std::exception & e) {
+        return set_error(e.what());
+    }
+    LOG_DBG("%s: grammar translated to llguidance:\n%s\n", __func__, lark.c_str());
+
+    LlgTokenizer * tokenizer = llama_sampler_llg_new_tokenizer(vocab);
+    if (!tokenizer) {
+        return set_error("cannot build the llguidance tokenizer");
+    }
+    // Compiling a large grammar takes up to a few hundred ms, and an agent sends the same tool set
+    // on every turn: keep the last compiled matchers and clone them.
+    static std::mutex                                                                cache_mutex;
+    static std::vector<std::pair<std::pair<const llama_vocab *, std::string>, LlgMatcher *>> cache;
+    constexpr size_t                                                                 cache_max = 8;
+    LlgMatcher * matcher = nullptr;
+    {
+        std::lock_guard<std::mutex> lock(cache_mutex);
+        for (const auto & [key, m] : cache) {
+            if (key.first == vocab && key.second == lark) {
+                matcher = llg_clone_matcher(m);
+                break;
+            }
+        }
+    }
+    if (!matcher) {
+        LlgConstraintInit cinit;
+        llg_constraint_init_set_defaults(&cinit, tokenizer);
+        const char * log_level = getenv("LLGUIDANCE_LOG_LEVEL");
+        if (log_level && *log_level) {
+            cinit.log_stderr_level = atoi(log_level);
+        }
+        matcher = llg_new_matcher(&cinit, "lark", lark.c_str());
+        if (llg_matcher_get_error(matcher)) {
+            std::string msg = llg_matcher_get_error(matcher);
+            llg_free_matcher(matcher);
+            llg_free_tokenizer(tokenizer);
+            return set_error("llguidance rejected the translated grammar: " + msg);
+        }
+        std::lock_guard<std::mutex> lock(cache_mutex);
+        if (cache.size() >= cache_max) {
+            llg_free_matcher(cache.front().second);
+            cache.erase(cache.begin());
+        }
+        cache.push_back({ { vocab, lark }, llg_clone_matcher(matcher) });
+    }
+
+    auto * ctx           = new llama_sampler_llg_gbnf;
+    ctx->vocab           = vocab;
+    ctx->tokenizer       = tokenizer;
+    ctx->matcher         = matcher;
+    ctx->lazy            = lazy;
+    ctx->awaiting        = lazy;
+    ctx->patterns        = trigger_patterns;
+    ctx->trigger_tokens  = trigger_tokens;
+    ctx->gbnf            = gbnf;
+    ctx->fallback        = nullptr;
+    ctx->failed          = false;
+    ctx->shadow          = nullptr;
+    ctx->shadow_failed   = false;
+    try {
+        for (const auto & p : trigger_patterns) {
+            ctx->regexes.emplace_back(p);
+        }
+    } catch (const std::exception & e) {
+        llg_free_matcher(matcher);
+        llg_free_tokenizer(tokenizer);
+        delete ctx;
+        return set_error(std::string("bad trigger pattern: ") + e.what());
+    }
+    if (!lazy && !generation_prompt.empty()) {
+        ctx->llg_prefill = common_tokenize(vocab, generation_prompt, false, false);
+        // the same tokens as the prefill of common_sampler_init, for the GBNF fallback
+        const auto tokens = common_tokenize(vocab, generation_prompt, false, true);
+        for (size_t i = 0; i < tokens.size(); i++) {
+            const std::string piece = common_token_to_piece(vocab, tokens[i], true);
+            if (i == 0 && !piece.empty() && std::isspace((unsigned char) piece[0]) && !std::isspace((unsigned char) generation_prompt[0])) {
+                continue;
+            }
+            ctx->gbnf_prefill.push_back(tokens[i]);
+        }
+    }
+    for (const auto t : ctx->llg_prefill) {
+        if (llg_matcher_consume_token(ctx->matcher, (uint32_t) t) != 0) {
+            std::string msg = llg_matcher_get_error(ctx->matcher);
+            llg_free_matcher(ctx->matcher);
+            llg_free_tokenizer(ctx->tokenizer);
+            delete ctx;
+            return set_error("llguidance rejected the generation prompt: " + msg);
+        }
+    }
+    return llama_sampler_init(&llama_sampler_llg_gbnf_i, ctx);
+}
