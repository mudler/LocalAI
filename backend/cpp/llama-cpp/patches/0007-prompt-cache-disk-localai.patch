+prompt_cache_policy::speeds server_prompt_cache_disk::speeds() const {
+    prompt_cache_policy::speeds res;
+    res.transfer_bps = opts.read_bps;
+    res.overhead_s   = opts.overhead_s;
+    res.prefill_tps = prefill_tps.load();
+    return res;
+}
