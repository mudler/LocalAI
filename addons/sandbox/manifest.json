    "toolDefinitions": [
      {
        "name": "bash",
        "description": "Run a bash script in /workspace/home, the user's files; only what is saved there stays. Output is cut at 64 KiB; timeoutSeconds is 120 by default, at most 1680. Network: curl, pip and git use the proxy; a blocked host asks the user, do not get around it. Prefer web_fetch or web_search for web pages. Put helper scripts and temp files in the chat's work folder if the prompt or the note names one.",
        "kind": "action",
        "inputSchema": {
          "additionalProperties": false,
          "properties": {
            "command": {
              "description": "The script to run.",
              "type": "string"
            },
            "timeoutSeconds": {
              "maximum": 1680,
              "minimum": 1,
              "type": "integer"
            }
          },
          "required": [
            "command"
          ],
          "type": "object"
        },
