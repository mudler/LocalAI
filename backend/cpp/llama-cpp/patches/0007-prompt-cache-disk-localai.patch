+void server_prompt_cache_disk::configure(const server_prompt_cache_disk_opts & opts_new) {
+    {
+        std::lock_guard<std::mutex> lk(mtx);
+        opts = opts_new;
+    }
+
+    // the prompt speed measured by the previous run of this model
+    {
+        std::ifstream in(dir / ".speed");
+        std::string key;
+        double value = 0;
+        if (in >> key >> value && key == "prefill_tps" && value > 0) {
+            meter.tps   = value;
+            prefill_tps = value;
+        }
+    }
+
+    SRV_INF("disk prompt cache: ttl = %lld s, min tokens = %llu, namespace quota = %.3f MiB, read speed = %.1f MB/s, prompt speed = %.1f t/s, write queue = %.3f MiB\n",
+            (long long) opts.ttl_s, (unsigned long long) opts.min_tokens, opts.ns_quota / (1024.0 * 1024.0),
+            opts.read_bps / 1e6, prefill_tps.load(), opts.queue_limit / (1024.0 * 1024.0));
+
+    if (opts.queue_limit > 0 && !writer.joinable()) {
+        writer = std::thread([this]() { writer_loop(); });
+    }
+}
+
+void server_prompt_cache_disk::save_speed() const {
+    const double tps = prefill_tps.load();
+    if (tps <= 0) {
+        return;
+    }
+    std::error_code ec;
+    const fs::path path     = dir / ".speed";
+    const fs::path path_tmp = dir / ".speed.tmp";
+    {
+        std::ofstream out(path_tmp, std::ios::trunc);
+        out << "prefill_tps " << tps << "\n";
+    }
+    fs::rename(path_tmp, path, ec);
+}
