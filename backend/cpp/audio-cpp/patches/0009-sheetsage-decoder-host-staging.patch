+void decoder_phase(int stage, bool after, const core::RunStopHandle & stop) {
+#ifdef ENGINE_SHEETSAGE_DECODER_HOST_TESTING
+    decoder_host_testing::phase(stage, after);
+#else
+    (void)stage; (void)after;
+#endif
+    encoder_stop(stop);
