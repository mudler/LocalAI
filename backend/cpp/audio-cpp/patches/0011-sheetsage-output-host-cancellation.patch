+    auto tempo_beats=beats;
+    while(tempo_beats.back().time<note_end-1.0e-6){
+        auto next=tempo_beats.back();
+        next.time+=period;
+        next.beat=next.beat%next.numerator+1;
+        tempo_beats.push_back(next);
+    }
+    const auto tempo_measures=infer_measures(tempo_beats);
+    if(!tempo_measures.empty()){
+        const auto tempo_times=subbeat_times_from_beats(tempo_beats);
+        const auto tempo_denominators=subbeat_denominators_from_measures(tempo_beats,tempo_measures,tempo_times.size());
+        const double seconds=tempo_times.back()-tempo_times.front();
