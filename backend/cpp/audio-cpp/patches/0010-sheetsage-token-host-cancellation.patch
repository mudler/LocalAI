+std::vector<int32_t> generate_tokens(
+    SheetSage2DecoderRuntime & decoder,const std::vector<float> & memory,int64_t memory_steps,
+    const SheetSage2Tokenizer & tokenizer,int64_t maximum,const std::vector<int32_t>* prefix,
+    std::optional<double> stop_time,int64_t context,core::RunStopHandle stop) {
+    token_host_limits(tokenizer,maximum,context);
+    if(memory_steps<=0 || static_cast<uint64_t>(memory_steps)>std::vector<float>().max_size()/1024 ||
+       memory.size()!=static_cast<size_t>(memory_steps)*1024)
+        throw std::runtime_error("SheetSage2 generation memory shape mismatch");
+    if(!stop) return generate_tokens(decoder,memory,memory_steps,tokenizer,maximum,prefix,stop_time);
+    auto host=token_prefix(tokenizer,maximum,context,prefix,stop);
+    token_phase(9,stop);
+    decoder.reset_cached_decode(memory,memory_steps,maximum);
+    token_phase(9,stop);
+    token_phase(10,stop);
+    auto logits=decoder.prefill_cached_decode(host.ids);
+    token_phase(10,stop);
+    for(int64_t step=static_cast<int64_t>(host.ids.size());step<maximum;++step){
+        int32_t token=select_next_token(logits,tokenizer,host.state,stop);
+        if(token_transition(host,tokenizer,token,stop_time,stop))break;
+        token_phase(11,stop);
+        logits=decoder.decode_cached_step(token);
+        token_phase(11,stop);
+    }
+    return token_publish(host,tokenizer,stop);
+}
