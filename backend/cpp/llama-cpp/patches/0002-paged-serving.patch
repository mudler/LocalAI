+    // LocalAI paged serving: admission, preemption and resume by recompute over the unified KV cache.
+    // The policy is in serving_policy.h. Only called when params_base.paged_serving is set.
+    int64_t n_paged_wait = 0, n_paged_preempt = 0, n_paged_abort = 0;
+
+    // cells of one slot, an estimate that counts cells shared with other slots once per slot
+    int64_t paged_n_cells(const server_slot & slot) const {
+        const llama_pos p0 = llama_memory_seq_pos_min(llama_get_memory(ctx_tgt), slot.id);
+        const llama_pos p1 = llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), slot.id);
+        return std::max<int64_t>(p0 < 0 ? 0 : p1 - p0 + 1, slot.prompt.n_tokens());
+    }
+
+    // cells in use by every slot but id_skip, each shared cell counted once
+    int64_t paged_used(int id_skip) const {
+        std::vector<serving_policy::slot_cells> c(slots.size());
+        for (size_t i = 0; i < slots.size(); i++) {
+            const auto & s = slots[i];
+            c[i].cells = s.id == id_skip ? 0 : paged_n_cells(s);
+            // a copied prefix stays shared while the source still runs the task it had at the copy
+            const bool live = s.paged_src >= 0 && s.paged_src < (int) slots.size() &&
+                              (slots[s.paged_src].task ? slots[s.paged_src].task->id : -2) == s.paged_src_task;
+            if (live) {
+                c[i].src    = s.paged_src;
+                c[i].shared = s.paged_src_n;
+            }
+        }
+        return serving_policy::unique_cells(c);
+    }
+
+    int64_t n_paged_attach = 0, n_paged_attach_tokens = 0;
+
+    // start a prompt from the cells of another slot that holds a longer prefix of it, busy or idle:
+    // seq_cp shares the cells, nothing is copied or computed again. Returns the new n_past.
+    int32_t paged_attach(server_slot & slot, int32_t n_past) {
+        if (!params_base.paged_attach || ctx_tgt_seq_rm_type != COMMON_CONTEXT_SEQ_RM_TYPE_PART || n_swa > 0 || mctx ||
+            slot.can_speculate() || slot.task->tokens.has_mtmd || slot.task->n_tokens_shared > 0 || lora_all_alora(slot.lora)) {
+            return n_past;
+        }
+        server_slot * best   = nullptr;
+        int32_t       best_n = n_past;
+        for (auto & other : slots) {
+            if (other.id == slot.id || other.prompt.tokens.has_mtmd || !are_lora_equal(other.prompt.lora, slot.lora) ||
+                llama_memory_seq_pos_min(llama_get_memory(ctx_tgt), other.id) != 0) {
+                continue;
+            }
+            // only cells that exist: a generating slot's last token is not decoded yet
+            const int32_t n_cells = llama_memory_seq_pos_max(llama_get_memory(ctx_tgt), other.id) + 1;
+            const int32_t n = std::min<int32_t>({ (int32_t) other.prompt.tokens.get_common_prefix(slot.task->tokens), n_cells, other.prompt.n_tokens() });
+            if (serving_policy::should_attach(best_n, n)) {
+                best   = &other;
+                best_n = n;
+            }
+        }
+        if (!best) {
+            return n_past;
+        }
+        slot.mem.seq_rm(slot.id, -1, -1);
+        slot.mem.seq_cp(best->id, slot.id, 0, best_n);
+        slot.prompt = best->prompt.clone();
+        slot.prompt.tokens.keep_first(best_n);
+        slot.prompt.checkpoints.clear();
+        slot.paged_src      = best->id;
+        slot.paged_src_n    = best_n;
+        slot.paged_src_task = best->task ? best->task->id : -2;
+        n_paged_attach_tokens += best_n - n_past;
+        SLT_INF(slot, "paged: attached %d prompt tokens of slot %d (attaches = %" PRId64 ", tokens saved = %" PRId64 ")\n",
+                best_n, best->id, ++n_paged_attach, n_paged_attach_tokens);
+        return best_n;
+    }
+
+    int64_t paged_prompt_left(const server_slot & slot) const {
+        if (!slot.paged_resume.empty()) {
+            return (int64_t) slot.paged_resume.size() - slot.prompt.n_tokens();
+        }
+        return slot.state == SLOT_STATE_GENERATING ? 0 : slot.task->n_tokens() - slot.prompt.n_tokens();
+    }
+
+    int64_t paged_reserve(const server_slot & slot) const {
+        return slot.task->need_sampling() ? serving_policy::effective_reserve(params_base.kv_output_reserve, slot.n_predict_max) : 0;
+    }
+
+    // admitted and running: holds cells now or will in this step
+    bool paged_running(const server_slot & slot) const {
+        return slot.is_processing() && !slot.paged_wait && slot.state != SLOT_STATE_STARTED && slot.state != SLOT_STATE_WAIT_OTHER;
+    }
+
+    // a slot whose state is only its text tokens and its sampler can be rebuilt by decoding them again
+    bool paged_resumable(const server_slot & slot) const {
+        return slot.task->type == SERVER_TASK_TYPE_COMPLETION && !slot.can_speculate() && !slot.task->tokens.has_mtmd &&
+               !slot.prompt.tokens.has_mtmd && !slot.task->is_parent() && !slot.task->is_child() &&
+               slot.task->n_tokens_shared == 0 && slot.inp_embd.empty() && !lora_all_alora(slot.lora) &&
+               ctx_tgt_seq_rm_type == COMMON_CONTEXT_SEQ_RM_TYPE_PART;
+    }
+
+    // a slot that waits for admission may still hold the cells of its previous task
+    bool paged_purgeable(const server_slot & slot) const {
+        return (!slot.is_processing() || slot.state == SLOT_STATE_STARTED || slot.paged_wait) && slot.prompt.n_tokens() > 0;
+    }
+
+    // drop the cached cells of one idle or waiting slot, other than id_keep
+    bool paged_purge(int id_keep) {
+        if (try_clear_idle_slots()) {
+            return true;
+        }
+        for (auto & slot : slots) {
+            if (slot.id != id_keep && slot.is_processing() && paged_purgeable(slot)) {
+                SLT_INF(slot, "paged: dropping %d cached tokens of a waiting slot\n", slot.prompt.n_tokens());
+                slot.prompt_clear();
+                return true;
+            }
+        }
+        return false;
+    }
+
+    // true when the slot may start (or resume) filling n_tokens cells now
+    bool paged_admit(server_slot & slot, int64_t n_tokens) {
+        while (true) {
+            serving_policy::pool_view v;
+            v.n_pool = llama_n_ctx(ctx_tgt);
+            v.n_used = paged_used(slot.id); // its own cells are reused or freed by the prompt fill
+            for (const auto & other : slots) {
+                if (other.id == slot.id) {
+                    continue;
+                }
+                v.idle_cells |= paged_purgeable(other);
+                if (paged_running(other)) {
+                    v.n_active++;
+                    v.n_pending += serving_policy::slot_claim(paged_prompt_left(other), paged_reserve(other), other.stats.n_gen);
+                } else if (other.is_processing() && (other.state == SLOT_STATE_STARTED || other.paged_wait) && other.task->id < slot.task->id) {
+                    v.older_waiting = true;
+                }
+            }
+            // a resumed request needs only the part of its reserve it has not generated yet
+            const int64_t n_need = serving_policy::slot_claim(n_tokens, paged_reserve(slot), slot.stats.n_gen);
+            const auto res = serving_policy::admit(v, n_need);
+            if (res == serving_policy::admit_result::ADMIT) {
+                if (slot.paged_t_preempted > 0) {
+                    SLT_INF(slot, "paged: resuming after waiting %.1f s\n", (ggml_time_us() - slot.paged_t_preempted) / 1e6);
+                    slot.paged_t_preempted = 0;
+                }
+                if (slot.paged_cache_load && prompt_cache) {
+                    // the cache load was held back at launch, so a waiting request holds no cells
+                    slot.paged_cache_load = false;
+                    if (!slot.prompt_load(*prompt_cache, slot.task->tokens, get_task_lora(*slot.task))) {
+                        slot.prompt_clear();
+                    }
+                    prompt_cache->update();
+                }
+                slot.paged_wait = false;
+                return true;
+            }
+            if (res == serving_policy::admit_result::PURGE_IDLE && paged_purge(slot.id)) {
+                continue;
+            }
+            if (!slot.paged_wait) {
+                slot.paged_wait = true;
+                SLT_INF(slot, "paged: waiting for %" PRId64 " free cells (used = %" PRId64 ", pending = %" PRId64 ", pool = %" PRId64 ", waits = %" PRId64 ")\n",
+                        n_need, v.n_used, v.n_pending, v.n_pool, ++n_paged_wait);
+            }
+            return false;
+        }
+    }
+
+    // make room for this step's decode and for the rest of the admitted prompts:
+    // drop idle or waiting cells first, then, with paged_preempt, preempt the youngest slot
+    void paged_preempt_pass() {
+        while (true) {
+            const int64_t n_used = paged_used(-1);
+            int64_t n_demand = 0;
+            std::vector<serving_policy::victim_candidate> cands;
+            for (auto & slot : slots) {
+                if (!paged_running(slot) || slot.state == SLOT_STATE_DONE_PROMPT) {
+                    continue;
+                }
+                const bool gen = slot.state == SLOT_STATE_GENERATING;
+                n_demand += serving_policy::slot_demand(gen, gen && slot.can_speculate() ? std::min(slot.get_n_draft_max(), 64) : 0, paged_prompt_left(slot));
+                const auto type = slot.task->type;
+                if (type != SERVER_TASK_TYPE_TTS && type != SERVER_TASK_TYPE_REALTIME && type != SERVER_TASK_TYPE_TRANSCRIBE_RT) {
+                    cands.push_back({ slot.id, slot.task->id, paged_resumable(slot), slot.paged_n_preempted });
+                }
+            }
+            if (!serving_policy::pool_short(llama_n_ctx(ctx_tgt), n_used, n_demand)) {
+                return;
+            }
+            if (paged_purge(-1)) {
+                continue;
+            }
+            if (!params_base.paged_preempt) {
+                return; // admission only, the decode path handles a full pool as before
+            }
+            const int i = serving_policy::pick_victim(cands);
+            if (i < 0) {
+                return; // one request left, the decode path handles it as before
+            }
+            paged_preempt(slots[cands[i].id_slot], cands[i].resumable);
+        }
+    }
+
+    void paged_preempt(server_slot & slot, bool resumable) {
+        if (!resumable) {
+            SLT_WRN(slot, "paged: KV pool full, aborting a request that cannot be resumed (last resort, aborts = %" PRId64 ")\n", ++n_paged_abort);
+            send_error(slot, "KV pool full, preempted; retry the request", ERROR_TYPE_UNAVAILABLE);
+            slot.release();
+            slot.prompt_clear();
+            return;
+        }
+        SLT_INF(slot, "paged: KV pool full, preempting %d tokens for recompute (this request: %d, preemptions = %" PRId64 ")\n",
+                slot.prompt.n_tokens(), ++slot.paged_n_preempted, ++n_paged_preempt);
+        slot.paged_t_preempted = ggml_time_us();
+        if (slot.state == SLOT_STATE_GENERATING) {
+            // keep every decoded token, the sampler and the grammar keep their state
+            slot.paged_resume = slot.prompt.tokens.get_text_tokens();
+            slot.state = SLOT_STATE_PROCESSING_PROMPT;
+        }
+        slot.prompt_clear();
+        slot.i_batch    = -1;
+        slot.paged_wait = true;
+    }
+
+    // decode the tokens of a preempted slot again, then let it generate from where it stopped
+    void paged_resume_fill(server_slot & slot, int32_t n_fill_max) {
+        while (slot.prompt.n_tokens() < (int32_t) slot.paged_resume.size() && batch.size() < n_fill_max) {
+            const llama_token tok = slot.paged_resume[slot.prompt.n_tokens()];
+            GGML_ASSERT(batch.add(slot.id, tok, slot.prompt.tokens.pos_next(), false, false));
+            slot.prompt.tokens.push_back(tok);
+        }
+        if (slot.prompt.n_tokens() == (int32_t) slot.paged_resume.size()) {
+            slot.paged_resume.clear();
+            slot.state = SLOT_STATE_GENERATING;
+        }
+    }
