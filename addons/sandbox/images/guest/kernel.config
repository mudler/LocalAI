# Guest kernel options for every architecture, merged into the architecture's
# defconfig. Everything is built in: the guest has no modules.
# CONFIG_MODULES is not set
CONFIG_PCI=y
CONFIG_PCI_MSI=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y
CONFIG_FUSE_FS=y
CONFIG_VIRTIO_FS=y
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_EXT4_FS=y
CONFIG_OVERLAY_FS=y
# CONFIG_OVERLAY_FS_REDIRECT_DIR is not set
# CONFIG_OVERLAY_FS_INDEX is not set
# CONFIG_OVERLAY_FS_METACOPY is not set
CONFIG_TMPFS=y
CONFIG_TMPFS_XATTR=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_UNIX98_PTYS=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_MULTIUSER=y
CONFIG_EPOLL=y
CONFIG_FUTEX=y
# A process in the guest holds CAP_DAC_OVERRIDE, so it can write root-owned
# files under /proc and /sys. These options remove what that write could
# reach: a core_pattern helper run as root, the uevent helper, sysrq, raw
# memory and port access, loop devices, debugfs (block I/O tracing selects
# it on by default) and kexec.
# CONFIG_COREDUMP is declared 'if EXPERT' with 'default y': without EXPERT the
# disable line below is overridden by the default, so EXPERT must be set.
CONFIG_EXPERT=y
# CONFIG_COREDUMP is not set
# CONFIG_UEVENT_HELPER is not set
# CONFIG_MAGIC_SYSRQ is not set
# CONFIG_BLK_DEV_LOOP is not set
# CONFIG_DEVMEM is not set
# CONFIG_DEVPORT is not set
# CONFIG_BLK_DEV_IO_TRACE is not set
# CONFIG_DEBUG_FS is not set
# CONFIG_KEXEC is not set
CONFIG_SECURITY_DMESG_RESTRICT=y
