Backport of ggml-org/llama.cpp#32219 ("server: add request priority"),
server sources only. server_task::priority (higher is served first) and the
deferred-queue pick by priority. LocalAI sets the priority from
PredictOptions.Priority. Drop this patch when the pin contains #32219.

diff --git a/tools/server/server-context.cpp b/tools/server/server-context.cpp
--- a/tools/server/server-context.cpp
+++ b/tools/server/server-context.cpp
@@ -6160,6 +6160,7 @@ std::unique_ptr<server_res_generator> server_routes::handle_completions_impl(
             task.apply_chat_session(chat_session);
 
             task.id_slot = json_value(data, "id_slot", -1);
+            task.priority = json_value(data, "priority", 0);
             sse_ping_interval = task.params.sse_ping_interval;
 
             // OAI-compat
diff --git a/tools/server/server-queue.cpp b/tools/server/server-queue.cpp
--- a/tools/server/server-queue.cpp
+++ b/tools/server/server-queue.cpp
@@ -89,25 +89,23 @@ int server_queue::get_new_id() {
 
 void server_queue::pop_deferred_task(int id_slot) {
     std::unique_lock<std::mutex> lock(mutex_tasks);
