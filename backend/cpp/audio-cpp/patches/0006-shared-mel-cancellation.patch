+std::vector<float> prepare_owned_normalized_mel(
+    const std::vector<float> & waveform, const SheetSage2Assets & assets,
+    size_t threads, int64_t & frames, core::RunStopHandle handle) {
+    if (!handle) return prepare_normalized_mel(waveform, assets, threads, frames);
+    const auto requested = [](void * p) noexcept {
+        return static_cast<core::RunStopState *>(p)->cancelled();
+    };
+    return prepare_normalized_mel(waveform, assets, threads, frames,
+                                  {requested, handle.get()});
+}
+
+
+void normalized_mel_consumer_boundary(const core::RunStopHandle & handle) {
+    if (handle && handle->cancelled()) throw runtime::RunCancelled();
+#ifdef ENGINE_MEL_TESTING
+    mel_testing::consuming();
+#endif
+}
