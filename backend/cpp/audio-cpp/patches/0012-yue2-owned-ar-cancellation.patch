+            const int64_t begin = std::max<int64_t>(0, range.begin);
+            const int64_t end = std::min<int64_t>(range.end, static_cast<int64_t>(logits.size()));
+            for (int64_t token = begin; token < end; ++token) {
+        auto completed=visit();
