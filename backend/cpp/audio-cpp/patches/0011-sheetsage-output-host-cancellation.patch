+runtime::TaskResult finish_sheetsage_output(const std::vector<SheetSage2Event> & source_events,double duration,
+    size_t token_count,int64_t last_memory_steps,size_t window_count,SheetSage2OutputDomain domain,core::RunStopHandle stop){
+    validate_sheetsage2_output(source_events,duration,domain);
+    // Canonical validation sorting is deliberately uninterruptible and private:
+    // renderer errors must win over a pre-existing stop on the actual finish path.
+    auto canonical=source_events;
+    std::sort(canonical.begin(),canonical.end(),[](const auto&a,const auto&b){if(a.time!=b.time)return a.time<b.time;return a.global_subbeat<b.global_subbeat;});
+    validate_sheetsage2_render_output(canonical,duration,domain);
+    auto owner=std::make_shared<SessionOutputOwner>(stop,domain);owner->check();
+    auto stitched_events=source_events;owner->check();
+    owner->comparison_family=7;owner->sort(stitched_events.begin(), stitched_events.end(), [](const auto & a, const auto & b) {
+        if (a.time != b.time) {
+            return a.time < b.time;
+        }
+        return a.global_subbeat < b.global_subbeat;
+    });
+
+    const auto abc = events_to_abc(
+        stitched_events,
+        duration,domain,stop);
+    const auto json = events_json(stitched_events,domain,stop);
+
+    owner->check(30);
+    runtime::TaskResult result;
+    result.text_output = runtime::Transcript{abc, "abc"};
+    owner->check(31);
+    result.artifact_output = runtime::make_text_artifact(
+        runtime::ArtifactKind::Custom,
+        "score",
+        abc,
+        {
+            {"mime", "text/vnd.abc"},
+            {"format", "abc"},
+            {"extension", "abc"},
+            {"tokens", std::to_string(token_count)},
+            {"memory_steps", std::to_string(last_memory_steps)},
+            {"windows", std::to_string(window_count)},
+        });
+    owner->check(32);
+    result.output_artifacts.push_back(runtime::make_text_artifact(
+        runtime::ArtifactKind::Custom,
+        "events",
+        json,
+        {
+            {"mime", "application/json"},
+            {"format", "sheetsage2-events-json"},
+            {"extension", "json"},
+        }));
+    owner->check(33);
+    return result;
+}
