+void encoder_stop(const core::RunStopHandle & stop) {
+    if (stop && stop->cancelled()) throw runtime::RunCancelled();
+}
+void encoder_phase(int stage, bool after, const core::RunStopHandle & stop) {
+#ifdef ENGINE_SHEETSAGE_RUNTIME_HOST_TESTING
+    host_testing::stage(stage, after);
+#else
+    (void)stage; (void)after;
+#endif
+    encoder_stop(stop);
