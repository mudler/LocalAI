 namespace engine::core {
 
+struct RunCallbackBridge {
+    RunStopHandle stop;
+    bool supported = false;
+};
+
+static bool abort_run(void * data) noexcept {
+    const auto & bridge = *static_cast<RunCallbackBridge *>(data);
+    return bridge.stop && bridge.stop->cancelled();
+}
+
+RunBinding::RunBinding(std::shared_ptr<RunCallbackBridge> bridge) noexcept
+    : bridge_(std::move(bridge)) {}
+RunBinding::~RunBinding() { bridge_->stop.reset(); }
+
+bool ExecutionContext::supports_cancellation() const noexcept {
+    return bridge_ && bridge_->supported;
+}
+bool ExecutionContext::stop_requested() const noexcept {
+    return bridge_ && bridge_->stop && bridge_->stop->cancelled();
+}
+RunBinding ExecutionContext::begin_cancellable_run(RunStopHandle stop) {
+    if (!stop || !supports_cancellation() || bridge_->stop) {
+        throw std::logic_error("cancellable run requires a supported idle context and stop handle");
+    }
+    bridge_->stop = std::move(stop);
+    // Guaranteed copy elision: no allocation/throw after the binding is published.
+    return RunBinding(bridge_);
+}
+
