+#ifdef ENGINE_STFT_TESTING
+namespace stft_testing {
+// stage: 0 framing, 1 reflection iterations, 2 transpose, 3 magnitude.
+void stored(int stage, size_t worker, size_t begin, size_t count, float value) noexcept;
+bool fft_returned(FFTStatus status) noexcept;
+void fft_context(const std::complex<float>* output, size_t frames, size_t bins) noexcept;
