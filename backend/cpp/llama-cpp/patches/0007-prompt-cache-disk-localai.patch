+bool server_prompt_cache_disk::check_space(uint64_t bytes) {
+    using prompt_cache_policy::disk_level;
+
+    std::error_code ec;
+    const auto sp = fs::space(dir, ec);
+    if (ec) {
+        return true; // no numbers, no watermark
+    }
+
+    const disk_level prev = level;
+    level = prompt_cache_policy::classify(sp.available, sp.capacity, prev, opts.free_space);
+    stats.level = (int32_t) level;
+
+    if (level != prev) {
+        if (level == disk_level::critical) {
+            SRV_WRN("disk prompt cache: the disk is almost full (%.1f GiB free of %.1f GiB), the disk prompt cache is off until there is room again\n",
+                    sp.available / 1073741824.0, sp.capacity / 1073741824.0);
+        } else if (level == disk_level::low) {
+            SRV_WRN("disk prompt cache: low disk space (%.1f GiB free of %.1f GiB), new prompts are not saved and the oldest are removed\n",
+                    sp.available / 1073741824.0, sp.capacity / 1073741824.0);
+        } else {
+            SRV_INF("%s", "disk prompt cache: enough free disk space again, saving prompts\n");
+        }
+    }
+
+    if (level != disk_level::ok) {
+        // give space back, least recently used first, down to the low watermark
+        uint64_t need = prompt_cache_policy::bytes_to_free(sp.available, sp.capacity, opts.free_space);
+        while (need > 0 && !entries.empty()) {
+            const uint64_t sz = entries.front().size;
+            remove(entries.begin());
+            stats.n_low_disk++;
+            need = need > sz ? need - sz : 0;
+        }
+        stats.n_low_disk++;
+        return false;
+    }
+
+    if (!prompt_cache_policy::room_for(bytes, sp.available, sp.capacity, opts.free_space)) {
+        stats.n_low_disk++;
+        return false;
+    }
+
+    return true;
+}
