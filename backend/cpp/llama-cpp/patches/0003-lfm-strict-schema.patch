+// SPDX-License-Identifier: MIT
+#pragma once
+
+#include "chat-peg-parser.h"
+#include <algorithm>
+#include <stdexcept>
+
+// Deliberately bounded subset for native Python-style strict tool calls. These
+// define canonical generation. Recognition validates decoded values separately;
+// generation order follows the schema's property order.
+class common_native_schema {
+    common_chat_peg_builder & b;
+    std::string prefix;
+
+    [[noreturn]] static void unsupported(const std::string & detail) {
+        throw std::runtime_error("strict native tool schema: " + detail);
+    }
+    static void keys(const common_json & s, const std::set<std::string> & allowed) {
+        if (!s.is_object()) { unsupported("expected a schema object"); }
+        for (const auto & e : s.items()) {
+            if (!allowed.count(e.key())) { unsupported("unsupported keyword " + e.key()); }
+        }
+    }
+    common_peg_parser alternatives(std::vector<std::string> values) {
+        // PEG ordered choice must try longer literals before their prefixes.
+        std::sort(values.begin(), values.end(), [](const std::string & a, const std::string & c) {
+            return a.size() != c.size() ? a.size() > c.size() : a < c;
+        });
+        auto p = b.choice();
+        for (const auto & value : values) { p |= b.literal(value); }
+        return p;
+    }
+    static int bound(const common_json & s, const char * key, int absent, int limit) {
+        if (!s.contains(key)) { return absent; }
+        const auto & n = s[key];
+        // Check type and range before narrowing. The small supported limit is
+        // exactly representable as double. Floats (even
+        // integral-looking ones), negatives and oversized unsigneds fail closed.
+        if (!n.is_number_integer() || n.get<double>() < 0 || n.get<double>() > limit) {
+            unsupported(std::string(key) + " must be a nonnegative integer <= " + std::to_string(limit));
+        }
+        return n.get<int>();
+    }
+    common_peg_parser string(const common_json & s) {
+        int lo = bound(s, "minLength", 0, 100000), hi = bound(s, "maxLength", -1, 100000);
+        if (lo < 0 || hi < -1 || (hi >= 0 && hi < lo) || lo > 100000 || hi > 100000) {
+            unsupported("invalid or excessive string length bounds");
+        }
+        if (s.contains("enum")) {
+            if (!s["enum"].is_array() || s["enum"].empty()) { unsupported("expected nonempty string enum"); }
+            std::vector<std::string> values;
+            for (const auto & v : s["enum"]) {
+                if (!v.is_string()) { unsupported("expected string enum member"); }
+                // The literal parser retains native quote normalization downstream.
+                std::string text = v.get<std::string>();
+                size_t length = 0;
+                for (unsigned char c : text) { if ((c & 0xc0) != 0x80) { ++length; } }
+                if (length < size_t(lo) || (hi >= 0 && length > size_t(hi))) { continue; }
+                values.push_back(v.dump());
+                std::string single = "'";
+                for (char c : text) {
+                    if (c == '\'' || c == '\\') { single += '\\'; }
+                    if (static_cast<unsigned char>(c) < 32) { unsupported("control character in enum"); }
+                    single += c;
+                }
+                values.push_back(single + "'");
+            }
+            if (s.contains("pattern")) { unsupported("enum combined with pattern"); }
+            if (values.empty()) { unsupported("enum has no values within length bounds"); }
+            return alternatives(values);
+        }
+        if (s.contains("pattern")) {
+            if (s["pattern"] != "^(0?[1-9]|[12][0-9]|3[0-2])/(0?[1-9]|[12][0-9]|3[0-2])$" || lo != 0 || hi != -1) {
+                unsupported("only the Sound musical-meter pattern is supported");
+            }
+            std::vector<std::string> values;
+            for (int n = 1; n <= 32; ++n) {
+                values.push_back(std::to_string(n));
+                if (n < 10) { values.push_back("0" + std::to_string(n)); }
+            }
+            auto meter = alternatives(values);
+            return b.choice({b.literal("\"") + meter + "/" + meter + "\"",
+                             b.literal("'") + meter + "/" + meter + "'"});
+        }
+        auto quoted = [&](char q) {
+            // One Unicode scalar or one native escape counts as one character.
+            // A UTF-16 surrogate pair in a Unicode escape is one scalar too.
+            auto hex = b.chars("[0-9a-fA-F]", 1, 1);
+            auto unicode = b.literal("\\u") + b.choice({
+                b.chars("[dD]", 1, 1) + b.chars("[89aAbB]", 1, 1) + b.repeat(hex, 2) +
+                    "\\u" + b.chars("[dD]", 1, 1) + b.chars("[c-fC-F]", 1, 1) + b.repeat(hex, 2),
+                b.chars("[0-9a-cA-Ce-fE-F]", 1, 1) + b.repeat(hex, 3),
+                b.chars("[dD]", 1, 1) + b.chars("[0-7]", 1, 1) + b.repeat(hex, 2)});
+            auto escaped = unicode | (b.literal("\\") + b.chars("[\"'\\\\/bfnrt]", 1, 1));
+            std::string excluded = q == '"' ? "^\"\\\\\\x00-\\x1f" : "^'\\\\\\x00-\\x1f";
+            auto unit = escaped | b.chars("[" + excluded + "]", 1, 1);
+            // The native grammar reader treats upper bounds above 2000 as
+            // unbounded. Keep every emitted repetition below that threshold.
+            auto unit_rule = b.rule(prefix + (q == '"' ? "-double-unit" : "-single-unit"), [&]() { return unit; });
+            auto content = b.literal("");
+            int required = lo;
+            while (required > 0) {
+                int count = std::min(required, 1000);
+                content = content + b.repeat(unit_rule, count, count);
+                required -= count;
+            }
+            if (hi < 0) {
+                content = content + b.zero_or_more(unit_rule);
+            } else {
+                std::function<common_peg_parser(int)> bounded = [&](int n) {
+                    if (n == 0) { return b.literal(""); }
+                    int block = 1;
+                    while (block * 2 <= n) { block *= 2; }
+                    auto exact = b.rule(prefix + (q == '"' ? "-d-exact-" : "-s-exact-") + std::to_string(block), [&]() {
+                        auto part = b.repeat(unit_rule, std::min(block, 1000), std::min(block, 1000));
+                        auto all = part;
+                        int remaining = block - std::min(block, 1000);
+                        while (remaining > 0) { int n = std::min(remaining, 1000); all = all + b.repeat(unit_rule, n, n); remaining -= n; }
+                        return all;
+                    });
+                    return b.rule(prefix + (q == '"' ? "-d-up-to-" : "-s-up-to-") + std::to_string(n), [&]() {
+                        return (exact + bounded(n - block)) | bounded(block - 1);
+                    });
+                };
+                content = content + bounded(hi - lo);
+            }
+            return b.literal(std::string(1,q)) + content + std::string(1,q);
+        };
+        return quoted('"') | quoted('\'');
+    }
+public:
+    common_native_schema(common_chat_peg_builder & builder, std::string name) : b(builder), prefix(std::move(name)) {}
+
+    common_peg_parser value(const common_json & s) {
+        keys(s, {"type", "description", "title", "enum", "minLength", "maxLength", "pattern", "minimum", "maximum"});
+        auto type = s.value("type", std::string());
+        if (type == "string") {
+            if (s.contains("minimum") || s.contains("maximum")) { unsupported("numeric bounds on string"); }
+            return string(s);
+        }
+        if (type != "integer" && type != "number") { unsupported("unsupported value type " + type); }
+        for (auto k : {"enum", "minLength", "maxLength", "pattern"}) {
+            if (s.contains(k)) { unsupported(std::string(k) + " on numeric value"); }
+        }
+        // Enumerating the integral part gives exact finite range enforcement,
+        // without relying on the generic converter (which ignores ranges).
+        if (!s.contains("minimum") || !s.contains("maximum") ||
+            !s["minimum"].is_number_integer() || !s["maximum"].is_number_integer()) {
+            unsupported("numeric values require integral minimum and maximum");
+        }
+        int lo = bound(s, "minimum", 0, 10000), hi = bound(s, "maximum", 0, 10000);
+        if (lo < 0 || hi < lo || hi > 10000) { unsupported("numeric range must satisfy 0 <= minimum <= maximum <= 10000"); }
+        std::vector<std::string> integral;
+        for (int n = hi; n >= lo; --n) { integral.push_back(std::to_string(n)); }
+        auto whole = alternatives(integral);
+        if (type == "integer") { return whole; }
+        // Native decimal spelling, including fractional durations. The upper
+        // endpoint can only have a zero fractional part. Exponents are not
+        // generated; semantic recognition also accepts in-range exponents.
+        std::vector<std::string> below;
+        for (int n = hi - 1; n >= lo; --n) { below.push_back(std::to_string(n)); }
+        auto fractional = b.literal(std::to_string(hi)) + "." + b.chars("[0]");
+        if (!below.empty()) { fractional |= alternatives(below) + "." + b.chars("[0-9]"); }
+        return fractional | whole;
+    }
+
+    common_peg_parser arguments(const common_json & s) {
+        keys(s, {"type", "properties", "required", "additionalProperties", "description", "title"});
+        if (s.value("type", std::string()) != "object" || !s.contains("additionalProperties") || s["additionalProperties"] != false) {
+            unsupported("expected object with additionalProperties:false");
+        }
+        auto props = s.value("properties", common_json::object());
+        if (!props.is_object()) { unsupported("properties must be an object"); }
+        auto required = s.value("required", common_json::array());
+        if (!required.is_array()) { unsupported("required must be an array"); }
+        std::set<std::string> req;
+        for (const auto & r : required) {
+            if (!r.is_string() || !props.contains(r.get<std::string>()) || !req.insert(r.get<std::string>()).second) {
+                unsupported("invalid required property");
+            }
+        }
+        std::vector<common_peg_parser> fields;
+        std::vector<bool> mandatory;
+        for (const auto & e : props.items()) {
+            auto field = b.tool_arg(b.tool_arg_open(b.tool_arg_name(b.literal(e.key())) + "=") +
+                                    b.tool_arg_value(value(e.value())) + b.tool_arg_close(b.eps()));
+            fields.push_back(field);
+            mandatory.push_back(req.count(e.key()) != 0);
+        }
+        // Two suffix states encode whether a comma is needed. Named rules keep
+        // all-optional schemas linear in size rather than expanding subsets.
+        std::function<common_peg_parser(size_t,bool)> suffix = [&](size_t n, bool seen) {
+            if (n == fields.size()) { return b.literal(""); }
+            return b.rule(prefix + "-args-" + std::to_string(n) + (seen ? "-next" : "-first"), [&]() {
+                auto take = (seen ? b.literal(",") + b.space() : b.eps()) + fields[n] + suffix(n+1, true);
+                return mandatory[n] ? take : take | suffix(n+1, seen);
+            });
+        };
+        return suffix(0, false);
+    }
+};
