<!-- Servers on a home network are often plain HTTP or use a private CA the user
     installed. Allow both; certificate errors are never bypassed. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
