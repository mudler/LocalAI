{
  "schemaVersion": 1,
  "id": "discord",
  "version": "0.1.0",
  "executable": "discord",
  "os": "linux",
  "arch": "amd64",
  "host": { "min": 1, "max": 1 },
  "api": {"min": 2, "max": 2},
  "protocol": { "min": 1, "max": 1 },
  "dataFormat": { "min": 1, "max": 1 },
  "capabilities": {
    "hostOperations": {
      "optional": ["connector.file.get", "connector.file.put"]
    },
    "connector": {
      "kinds": [
        {
          "id": "discord",
          "title": "Discord",
          "description": "Talk to one of your saved agents from Discord, in direct messages and where the bot is mentioned in a channel or thread.",
          "senderHint": "A user ID or a channel ID (numbers, with Developer Mode on)",
          "delivery": "pull",
          "files": {
            "receive": { "maxBytes": 10485760 },
            "send": { "maxBytes": 10485760 }
          },
          "page": "bots",
          "previewMs": 1000,
          "history": { "thread": true, "maxMessages": 30 },
          "options": [
            {
              "id": "followThreads",
              "title": "Threads the bot follows",
              "description": "Whether the bot answers messages in a thread without a new mention.",
              "default": "mentioned",
              "values": [
                { "id": "mentioned", "title": "Threads where it was mentioned" },
                { "id": "never", "title": "None: always ask with a mention" }
              ]
            }
          ]
        }
      ]
    },
    "ui": {
      "entry": "ui/discord.js",
      "css": ["ui/discord.css"],
      "sdk": { "min": 2, "max": 2 },
      "pages": ["bots"],
      "mainPage": "bots",
      "icon": "ui/icon.png",
      "title": "Discord",
      "description": "Bind a Discord bot to one of your saved agents, so people can talk to it from Discord."
    }
  }
}
