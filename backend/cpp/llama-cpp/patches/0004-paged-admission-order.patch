+    // slots in the order the prompt fill visits them: parents before children, each group by paged_key
+    std::vector<server_slot *> paged_fill_order() {
+        std::vector<server_slot *> order;
+        for (int pass = 0; pass < 2; ++pass) {
+            const size_t first = order.size();
+            for (auto & slot : slots) {
+                if ((slot.is_processing() && slot.task->is_child()) == (pass == 1)) {
+                    order.push_back(&slot);
+                }
+            }
+            std::vector<std::pair<serving_policy::wait_key, server_slot *>> keyed;
+            for (size_t i = first; i < order.size(); i++) {
+                if (order[i]->is_processing() && order[i]->state != SLOT_STATE_GENERATING) {
+                    keyed.push_back({ paged_key(*order[i]), order[i] });
+                }
+            }
+            std::stable_sort(keyed.begin(), keyed.end(), [&](const auto & a, const auto & b) {
+                return serving_policy::goes_before(a.first, b.first, queue_tasks.order);
+            });
+            // the waiting and prefilling slots first, in key order; the rest keep their index order
+            std::vector<server_slot *> rest;
+            for (size_t i = first; i < order.size(); i++) {
+                if (!(order[i]->is_processing() && order[i]->state != SLOT_STATE_GENERATING)) {
+                    rest.push_back(order[i]);
+                }
+            }
+            order.resize(first);
+            for (auto & k : keyed) {
+                order.push_back(k.second);
