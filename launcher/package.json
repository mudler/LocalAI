{
  "name": "localai-launcher",
  "productName": "LocalAI Launcher",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop launcher for LocalAI: install, start, stop and open the WebUI",
  "license": "MIT",
  "author": "LocalAI contributors",
  "main": "dist/node/main/index.js",
  "desktopName": "local-ai-launcher.desktop",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:renderer",
    "dev": "npm run build && electron .",
    "start": "electron .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "dist:appimage": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "dist:appimage:arm64": "npm run build && electron-builder --linux AppImage --arm64 --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --arm64 --publish never",
    "dist:win": "npm run build && electron-builder --win nsis zip --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.7",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.0.0",
    "@types/picomatch": "^4.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/semver": "^7.5.0",
    "@vitejs/plugin-react": "^6.0.2",
    "builder-util-runtime": "^9.7.0",
    "electron": "45.3.2",
    "electron-builder": "26.18.0",
    "i18next": "^26.0.8",
    "js-yaml": "^4.1.0",
    "jsdom": "^26.1.0",
    "picomatch": "^4.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^17.0.6",
    "react-router-dom": "7.18.2",
    "semver": "^7.8.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.14",
    "vitest": "^3.2.0"
  }
}
